{
  "name": "@workspace/clash-of-mercy",
  "version": "1.6.6",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "serve": "vite preview",
    "android:sync": "npm run build && node -e \"require('node:fs').rmSync('dist/download',{recursive:true,force:true})\" && npx cap sync android",
    "android:apk": "npm run android:sync && cd android && gradlew.bat assembleRelease",
    "release:manifest": "node scripts/write-update-manifest.mjs",
    "prebuild": "node scripts/check-supabase-env.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^7.6.10",
    "@capacitor/cli": "^7.6.10",
    "@capacitor/core": "^7.6.10",
    "@supabase/supabase-js": "^2.119.0",
    "lucide-react": "^0.545.0",
    "react": "19.1.0",
    "react-dom": "19.1.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "tailwindcss": "^4.1.14",
    "vite": "^7.3.2"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
